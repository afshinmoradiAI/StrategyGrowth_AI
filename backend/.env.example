# --- Required ---
ANTHROPIC_API_KEY=your-key-here

# --- Model & generation limits ---
DEFAULT_MODEL=claude-sonnet-4-5
MAX_TOKENS=4096
# Hard cap on output tokens per Anthropic call (circuit-breaker)
MAX_OUTPUT_TOKENS_PER_CALL=8192
# Enable Anthropic message-content caching (cuts cost on long inputs)
ENABLE_MESSAGE_CACHE=true

# --- Logging & observability ---
LOG_LEVEL=INFO

# --- Auth ---
# CHANGE THIS in production (used to sign JWTs)
SECRET_KEY=dev-secret-change-in-production
# Empty = X-API-Key auth disabled (dev). Set to enable shared-key gating.
APP_API_KEY=

# --- Rate limiting (slowapi) ---
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_ANONYMOUS=10/minute

# --- Retries (tenacity, transient Anthropic errors) ---
AGENT_MAX_RETRIES=3
AGENT_RETRY_MIN_SECONDS=1.0
AGENT_RETRY_MAX_SECONDS=10.0

# --- Optional ---
# DB_PATH=backend/data/plans.db
# Optional: enables real lead search via Google Places API
# GOOGLE_PLACES_API_KEY=
